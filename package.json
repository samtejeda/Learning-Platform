{
  "name": "learning-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:vercel": "bash scripts/vercel-build.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:http": "INTEGRATION_TESTS=1 dotenv -e .env.local -- vitest run -c vitest.http.config.mts",
    "test:integration":"INTEGRATION_TESTS=1 dotenv -e .env.local -- vitest run -c vitest.integration.config.mts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:check": "dotenv -e .env.local -- drizzle-kit check",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "screenshots": "node scripts/screenshots.mjs",
    "tab-order": "node scripts/tab-order.mjs",
    "form-check": "node scripts/form-check.mjs",
    "auth-session": "node scripts/auth-session.mjs",
    "flow-core-crud": "node scripts/flow-core-crud.mjs",
    "db-query": "dotenv -e .env.local -- node scripts/db-query.mjs",
    "flow-lecture": "node scripts/flow-lecture.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
