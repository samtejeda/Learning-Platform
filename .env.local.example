# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your deployed URL (or http://localhost:3000 for local dev).
# Used to build auth email links (confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry error tracking (optional). With no DSN every Sentry call is a no-op,
# so local dev and CI need none of these. In Vercel set all four for Production
# (and Preview if you want previews tracked). Setup: docs/RUNBOOK.md.
#   NEXT_PUBLIC_SENTRY_DSN  project DSN (public by design; also allow-listed in the CSP)
#   SENTRY_AUTH_TOKEN       build-time only, secret: uploads source maps privately
#   SENTRY_ORG / SENTRY_PROJECT  slugs from your Sentry URL
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Database — runtime connection. Use the "Transaction" pooler connection
# string from Supabase (port 6543, not the direct 5432 connection).
# NOTE: if your DB password contains "@", "#", "/" or "%", percent-encode it
# (e.g. "@" → "%40"), otherwise the URL is ambiguous and the connection fails.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional: connections each app instance holds (1-20). Default 5 in production,
# 1 in dev. Instances x this number is what reaches the pooler, so raise it with
# care. See docs/RUNBOOK.md, "Scaling notes".
# DB_POOL_MAX=5

# Database — migrations only (drizzle-kit generate/migrate/check/studio).
# Use the "Session" pooler connection string (port 5432). DDL and function
# bodies are safer over a session-mode connection than the transaction pooler.
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Vercel environment scopes (Project → Settings → Environment Variables) ---
# Production: all five variables above. DIRECT_URL is REQUIRED here because the
#   production build runs `drizzle-kit migrate` (scripts/vercel-build.sh).
# Preview: the four runtime variables only (NEXT_PUBLIC_*, DATABASE_URL),
#   ideally pointing at a separate dev Supabase project. NEVER set DIRECT_URL
#   in Preview scope; previews must not be able to migrate production.
# NEXT_PUBLIC_SITE_URL in Production must be the real https:// origin.
